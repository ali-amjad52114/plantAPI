# PlantAPI — copy to .env / .env.local and fill in. Never commit real values.
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5.5
OPENAI_MODEL_SMART=gpt-5.5
# Agent37
AGENT37_API_KEY=
AGENT37_BASE_URL=https://api.agent37.com/v1
AGENT37_INSTANCE_ID=
# Supabase
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Monid
MONID_API_KEY=
# Odoo (JSON-2 read/write key; MCP token is read-only)
ODOO_URL=
ODOO_DB=
ODOO_API_KEY=
ODOO_MCP_URL=
ODOO_MCP_TOKEN=
# Fiix (driven through the Agent37 browser)
FIIX_URL=
FIIX_USERNAME=
FIIX_PASSWORD=
# Google / Slack (connected through Agent37 app connections)
PLANTAPI_SCHEDULE_SHEET_ID=
PLANTAPI_CALENDAR_ID=
PLANTAPI_NOTICE_EMAIL=
PLANTAPI_SLACK_CHANNEL=
# Feature switches
PLANTAPI_FULL_TEAM=1
PLANTAPI_AGENT37_DEPTH=1
